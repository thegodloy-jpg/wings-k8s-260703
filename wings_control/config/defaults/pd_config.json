        "HCCL_EXEC_TIMEOUT": "2000",
        "HCCL_CONNECT_TIMEOUT": "1200",
        "VLLM_ASCEND_ENABLE_FUSED_MC2": "0",
        "HCCL_LOGIC_SUPERPOD_ID": "__PD_INDEX__",
        "HCCL_INTER_HCCS_DISABLE": "true",
        "HCCL_INTRA_ROCE_ENABLE": "1"
      },
      "common": {
        "use_vllm_serve": true,
